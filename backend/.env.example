# backend/.env 템플릿. 복사해서 backend/.env로 만들고 실제 값을 채운 뒤 사용한다.
#   cp backend/.env.example backend/.env

DB_USERNAME=trendfit
DB_PASSWORD=trendfit

# Google Cloud Console에서 발급받은 OAuth 2.0 "웹 애플리케이션" 클라이언트 ID.
# app/lib/config/app_config.dart의 googleWebClientId, app/web/index.html의
# google-signin-client_id meta 태그와 동일한 값이어야 한다.
TRENDFIT_ID=

# JWT 서명 비밀키(구글과 무관, 우리 서버 전용, 32바이트 이상 랜덤 문자열). 예: openssl rand -base64 48
TRENDFIT_PASSWORD=

# 구글 Client Secret. 현재 코드(액세스 토큰 검증 방식)는 쓰지 않지만 이름을 구분해 보관해둔다.
TRENDFIT_GOOGLE_SECRET=

CLAUDE_API_KEY=
WEATHER_API_KEY=

# 네이버쇼핑 검색 API (A6, 2026-07-29 결정). developers.naver.com > Application 등록 >
# "검색" API 사용 설정에서 발급. 미설정이어도 '+1 아이템'은 상품 링크 없이 동작한다.
NAVER_SHOPPING_CLIENT_ID=
NAVER_SHOPPING_CLIENT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:8765,http://localhost:3000,http://localhost:5000

# 이미지 스토리지(A4 결정). local(기본값) 또는 r2. 배포 환경(Railway)은 r2 + 아래 값을 채운다.
# Cloudflare 대시보드 R2 > Manage API Tokens에서 발급.
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
